# Generated from randomcontainers/sphinx package.yml by randomcontainers/ci. Do not edit.
FROM graphviz AS base
FROM sphinx AS sphinx
FROM base
USER 0:0
ARG DEBIAN_FRONTEND=noninteractive
COPY --link --from=sphinx /usr/local/ /usr/local/
RUN set -eu; \
    for f in /usr/local/share/randomcontainers/*/runtime-deps; do cat "$f"; echo; done > /tmp/runtime-deps; \
    sort -u -o /tmp/runtime-deps /tmp/runtime-deps; \
    if grep -Ev '^([a-z0-9][a-z0-9+.-]*)?$' /tmp/runtime-deps >&2; then echo 'runtime-deps: invalid package name' >&2; exit 1; fi; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends < /tmp/runtime-deps; \
    rm -rf /var/lib/apt/lists/* /tmp/runtime-deps; \
    ldconfig
ENV PYTHONUNBUFFERED=1
USER 1000:1000
ENTRYPOINT ["tini","--","sphinx-build"]
CMD ["-M","html",".","_build"]
